  m_Name: Gameplay-SafeArea
  m_EditorClassIdentifier: 
  Id: safearea
  tutorialTitle: Safe Area
  tutorialTitles: []
  tutorialText: 'Safe areas are zones where no combat can occur. Monsters cannot
    attack players, players cannot attack monsters, players cannot attack players.


    The
    walled town is such a safe area. You can see you are in a safe area by the blue
    shield icon above player character heads. This UI can be changed by editing the
    CanvasIsInSafeArea prefab.


    To create a Safe area, add the SafeArea script
    to a GameObject with BoxCollider and Trigger enabled.'
  tutorialTexts: []
  tutorialImage: {fileID: 21300000, guid: 1ab2518c5cb5a0241882001fcce02e19, type: 3}
